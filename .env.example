# Copy to .env.local (gitignored). On a Mac, scripts/setup.sh creates it for you.

# iOS bundle ID for builds made on YOUR Mac with `npm run ios:device`.
# Must be unique per person while the team uses free Apple IDs.
# Delete this line once everyone is on the shared paid/UW Apple team.
FES_IOS_BUNDLE_ID=com.insightwisconsin.fes.yourname

# Optional: your Apple team ID (Xcode > Settings > Accounts). Skips the
# "Development team for signing the app" prompt after a clean prebuild.
# FES_APPLE_TEAM_ID=ABCDE12345
